APP_ENV=dev
APP_HOST=0.0.0.0
APP_PORT=8000
APP_PUBLIC_URL=http://localhost:8000
ALLOWED_UIDS=*

# Qdrant Cloud
QDRANT_URL=https://xxxx.cloud.qdrant.io:6333
QDRANT_API_KEY=
QDRANT_COLLECTION_PREFIX=memoria

# Embeddings
EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536

# Lyzr
LYZR_API_KEY=
LYZR_BASE_URL=https://agent-prod.studio.lyzr.ai
LYZR_USER_ID=memoria-demo
LYZR_MANAGER_ID=
LYZR_GATEKEEPER_ID=
LYZR_POLICY_ID=
LYZR_LIBRARIAN_ID=
LYZR_FORGETTER_ID=
LYZR_REGISTRAR_ID=
LYZR_ANALYST_ID=

# Fallback if Lyzr is unset: use OpenAI JSON mode with the same prompts
LYZR_FALLBACK=openai

# Demo
DEMO_PRINCIPAL=self
